# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public canonical app URL, e.g. https://teamkit.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Template storage: local (browser localStorage) or supabase (shared database)
NEXT_PUBLIC_TEMPLATE_STORAGE_MODE=local
